        },
        {
          "layer_id": 3,
          "name": "Agentic Core",
          "orchestration_pattern": {
            "type": "Hierarchical Orchestrator",
            "workflow": "Sequential Sub-Pipelines"
          },
          "agents": [
            {
              "agent_id": 1,
              "name": "Orchestrator Agent",
              "role": "Central coordinator",
              "reasoning_framework": "Plan-and-Execute",
              "model_tier": "GPT-4o / Claude Sonnet",
              "responsibilities": [
                "Task decomposition",
                "Sub-agent delegation",
                "Error handling",
                "Termination management"
              ]
            },
            {
              "agent_id": 2,
              "name": "Document Intake & Process Agent",
              "role": "Document ingestion and parsing",
              "processing_pipeline": [
                "Document type detection",
                "OCR extraction",
                "Metadata extraction",
                "Semantic chunking",
                "Entity extraction"
              ],
              "supported_inputs": [
                "KT Documents",
                "Ticket Logs",
                "ServiceNow exports",
                "Unstructured documents"
              ],
              "output_schema": {
                "chunks": [],
                "metadata": {},
                "entities": []
              },
              "model_tier": "GPT-4o-mini"
            },
            {
              "agent_id": 3,
              "name": "Knowledge Base Builder Agent",
              "role": "Build vector store and knowledge graph",
              "responsibilities": [
                "Generate embeddings",
                "Index vector DB",
                "Build knowledge graph",
                "Freshness scoring",
                "TTL management"
              ],
              "storage_targets": [
                "Vector DB",
                "Knowledge Graph"
              ]
            },
            {
              "agent_id": 4,
              "name": "Risk Analysis Agent",
              "role": "Core analytical intelligence",
              "reasoning_framework": "Reflexion / Self-Refine",
              "analysis_dimensions": [
                "KT coverage gaps",
                "Historical pain points",
                "SLA risk flags",
                "Knowledge dependency risks",
                "Severity classification",
                "Mitigation recommendations"
              ],
              "rag_integration": {
                "retrieval_type": "Hybrid Retrieval",
                "techniques": [
                  "Dense retrieval",
                  "Sparse retrieval",
                  "Cross-encoder reranking",
                  "GraphRAG"
                ]
              },
              "output_schema": {
                "risk_items": [],
                "severity": "",
                "evidence": [],
                "recommendations": []
              }
            },
            {
              "agent_id": 5,
              "name": "Report Generator Agent",
              "role": "Generate formatted Word document",
              "features": [
                "PwC branding",
                "Heading hierarchy",
                "Severity color coding",
                "Table formatting"
              ],
              "output_format": [
                "Structured JSON",
                "Markdown",
                "DOCX"
              ],
              "tool": "python-docx"
            },
            {
              "agent_id": 6,
              "name": "Chat Bot Agent",
              "role": "Post-KT conversational assistant",
              "reasoning_framework": "ReAct",
              "capabilities": [
                "Question answering",
                "Context retrieval",
                "Clarification support",
                "Human escalation"
              ],
              "memory_systems": {
                "episodic_memory": true,
                "semantic_memory": true,
                "procedural_memory": true
              }
            }
          ]
        },
        {
          "layer_id": 4,
          "name": "RAG and Knowledge Systems",
          "rag_pipeline": [
            {
              "stage": 1,
              "name": "Query Analysis",
              "components": [
