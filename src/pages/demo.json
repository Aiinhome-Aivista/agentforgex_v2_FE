              "stage": 3,
              "name": "Hybrid Retrieval",
              "components": [
                "Dense Retrieval",
                "Sparse Retrieval",
                "RRF"
              ]
            },
            {
              "stage": 4,
              "name": "Metadata Filtering",
              "components": [
                "Filter Engine"
              ]
            },
            {
              "stage": 5,
              "name": "Re-Ranking",
              "components": [
                "Cross-Encoder Re-Ranker"
              ]
            },
            {
              "stage": 6,
              "name": "GraphRAG",
              "components": [
                "Knowledge Graph Traversal"
              ]
            },
            {
              "stage": 7,
              "name": "Retrieval Rails",
              "components": [
                "Safety Filter",
                "Freshness Validation"
              ]
