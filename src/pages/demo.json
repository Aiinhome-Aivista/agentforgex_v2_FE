  "sections": [
    {
      "section_number": "1",
      "title": "Executive Summary",
      "content": {
        "purpose": "Agentic AI application for KT risk moderation during managed services engagements.",
        "problem_statement": "Gap between KT documentation and actual execution realities.",
        "primary_goals": [
          "Identify risks proactively",
          "Highlight SLA risks",
          "Detect failure-prone areas",
          "Generate structured Word reports",
          "Provide chatbot for post-KT support"
        ],
        "design_philosophy": {
          "statement": "AI agents are distributed software systems built around reasoning engines, context management, memory systems, tool ecosystems, and governance frameworks."
        }
      }
    },
    {
      "section_number": "2",
      "title": "Solution Overview & Design Principles",
      "subsections": [
        {
          "section_number": "2.1",
          "title": "Design Principles Aligned to Best Practices",
          "principles": [
            {
              "id": 1,
              "name": "Context is King",
              "application": "Context engineering across KT documents, ticket logs, and process knowledge"
            },
            {
              "id": 2,
              "name": "System Prompts are Architecture",
              "application": "Production-grade system prompts with boundaries and safety guardrails"
            },
            {
              "id": 3,
              "name": "Agent Loop as Control System",
              "application": "Observe → Reason → Plan → Act → Evaluate → Update Memory"
            },
            {
              "id": 4,
              "name": "Plan-and-Execute Reasoning",
              "application": "Structured multi-step workflow orchestration"
            },
            {
              "id": 5,
              "name": "Design for Multi-Agent from Day One",
              "application": "Architect for specialist sub-agents"
            },
            {
              "id": 6,
              "name": "Guardrails are Load-Bearing Walls",
              "application": "Enterprise-grade safety implementation"
            },
            {
              "id": 7,
              "name": "Evals are the Test Suite",
              "application": "Eval-driven development using RAGAS"
            }
          ]
        },
        {
          "section_number": "2.2",
          "title": "Agent Category Classification",
          "categories": [
            {
              "type": "Advisory Agent",
              "description": "Proactive risk identification and SLA advisory"
            },
            {
              "type": "Conversational Agent",
              "description": "Post-KT chatbot for ongoing support"
            }
          ]
        }
      ]
    },
    {
